{
	"name": "rockide-vscode",
	"displayName": "Rockide",
	"description": "VSCode extension for Minecraft Bedrock that provides rich auto-completions, go-to definitions, and schema validation.",
	"publisher": "rockide",
	"version": "0.7.0",
	"engines": {
		"vscode": "^1.99.0"
	},
	"categories": [
		"Programming Languages"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/rockide/rockide-vscode"
	},
	"main": "./dist/extension.cjs",
	"type": "module",
	"scripts": {
		"vscode:prepublish": "npm run package",
		"compile": "npm run check-types && npm run lint && node esbuild.js",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.js --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"package": "npm run check-types && npm run lint && node esbuild.js --production",
		"check-types": "tsc --noEmit",
		"fmt": "dprint fmt",
		"lint": "eslint src",
		"update-schemas": "node scripts/update-schemas.js"
	},
	"dependencies": {
		"modern-tar": "^0.6.1",
		"semver": "^7.7.4",
		"vscode-languageclient": "^9.0.1",
		"which": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.0",
		"@types/node": "22.x",
		"@types/semver": "^7.7.1",
		"@types/vscode": "^1.99.0",
		"@types/which": "^3.0.4",
		"dprint": "^0.50.2",
		"esbuild": "^0.28.1",
		"eslint": "^9.39.4",
		"npm-run-all": "^4.1.5",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.1"
	},
	"activationEvents": [
		"onCommand:rockide.update",
		"onLanguage:json",
		"onLanguage:jsonc",
		"workspaceContains:**/*.mcfunction",
		"workspaceContains:**/*.mcstructure",
		"workspaceContains:**/*.mcworld"
	],
